# Public site URL used for canonical links, Open Graph, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43127

# Optional public contact details. Leave blank to hide them from the site.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_STREET=
NEXT_PUBLIC_CONTACT_CITY=
NEXT_PUBLIC_LINKEDIN_URL=

# Optional webhook for the contact form. When unset, submissions use the mock handler.
CONTACT_WEBHOOK_URL=
